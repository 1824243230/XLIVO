<launch>
  <!-- HBUS LIDAR_FRONT + CAM_FRONT_MID + IMU. -->
  <arg name="rviz" default="true" />
  <arg name="use_sim_time" default="true" />
  <param name="/use_sim_time" value="$(arg use_sim_time)" />

  <rosparam command="load" file="$(find fast_livo)/config/lg.yaml" />
  <node pkg="fast_livo" type="fastlivo_mapping" name="laserMapping" output="screen" required="true">
    <rosparam command="load" file="$(find fast_livo)/config/camera_lg.yaml" />
  </node>

  <group if="$(arg rviz)">
    <node pkg="rviz" type="rviz" name="rviz" args="-d $(find fast_livo)/rviz_cfg/fast_livo2.rviz" />
  </group>
</launch>
